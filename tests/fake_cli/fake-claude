#!/usr/bin/env python3
"""Stand-in for `claude` in aicli's tests. Spends no quota.

`-p /usage` prints usage-claude.txt from this directory, or the file $FAKE_CLAUDE_USAGE names. An argv containing
`--output-format stream-json` prints the canned stream-claude.jsonl, so
server.py's streaming path has something deterministic to parse. Any other
argv is echoed back as a JSON array on stdout, so a test can assert exactly
what `aicli run`/`argv`/the service built, without needing a real CLI.
`--output-format json` wraps that echo in claude's JSON result, token counts included.

FAKE_CLI_SLEEP, FAKE_CLI_EXIT_CODE and FAKE_CLI_STDERR let a test simulate a
slow, failing or noisy CLI without touching the argv the service builds.
"""
import json
import os
import sys
import time
from pathlib import Path

sleep_s = os.environ.get("FAKE_CLI_SLEEP")
if sleep_s:
    time.sleep(float(sleep_s))

stderr_text = os.environ.get("FAKE_CLI_STDERR")
if stderr_text:
    print(stderr_text, file=sys.stderr)

args = sys.argv[1:]
if args[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": True, "authMethod": "oauth"}))
elif args[:2] == ["auth", "login"]:
    print("Opening browser to sign in…")
    print("If the browser didn't open, visit: https://claude.com/cai/oauth/authorize?code=true&client_id=fake-id&state=fake-state")
    sys.stdout.flush()
    code = sys.stdin.readline().strip()
    if code == "valid-code":
        sys.exit(0)
    else:
        print("Invalid code", file=sys.stderr)
        sys.exit(1)
elif args[:2] == ["-p", "/usage"]:
    print(Path(os.environ.get("FAKE_CLAUDE_USAGE") or Path(__file__).with_name("usage-claude.txt")).read_text(), end="")
elif "--output-format" in args and "stream-json" in args:
    for line in Path(__file__).with_name("stream-claude.jsonl").read_text().splitlines():
        print(line)
        sys.stdout.flush()
elif "--output-format" in args and "json" in args:
    # what `claude -p --output-format json` prints; the answer is the argv echo
    print(json.dumps({"type": "result", "result": json.dumps([sys.argv[0], *args]),
                      "usage": {"input_tokens": 3, "output_tokens": 7},
                      "modelUsage": {"claude-sonnet-5": {"inputTokens": 3, "outputTokens": 7,
                                                         "cacheReadInputTokens": 100,
                                                         "cacheCreationInputTokens": 20}}}))
else:
    print(json.dumps([sys.argv[0], *args]))

sys.exit(int(os.environ.get("FAKE_CLI_EXIT_CODE", "0")))
